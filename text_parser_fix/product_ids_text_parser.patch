+def _legacy_search_products(observation):
+    """Parse only complete legacy result pages; ambiguity grants no product IDs.
+
+    The fixed result template emits a header, optional query/navigation, then
+    ID/title/price triplets. A literal SEP in content is ambiguous and must not
+    make the parser resynchronize at a later number. The terminal footer must
+    independently identify exactly the same unique products.
+    """
+    if observation.startswith(
+        ("[SHOPPING_OBSERVATION_V2]\n", "[SHOPPING_OBSERVATION_PROJECTION]\n")
+    ):
+        return []
+    if any(
+        observation.count(marker) != 1
+        for marker in ("搜索功能是否可用:", "可点击的按钮:")
+    ):
+        return []
+    footer = re.search(
+        r"\n\n搜索功能是否可用: (?:True|False)\n{1,2}"
+        r"可点击的按钮: (\[[^\n]*\])\n?\Z",
+        observation,
+    )
+    if footer is None:
+        return []
+    try:
+        buttons = json.loads(footer.group(1))
+    except json.JSONDecodeError:
+        return []
+    if not isinstance(buttons, list) or any(not isinstance(x, str) for x in buttons):
+        return []
+    if len(buttons) != len(set(buttons)):
+        return []
+    navigation = {"back to search", "< prev", "next >"}
+    if "back to search" not in {button.casefold() for button in buttons}:
+        return []
+    if any(
+        button.casefold() not in navigation and not re.fullmatch(r"[0-9]{8,12}", button)
+        for button in buttons
+    ):
+        return []
+
+    segments = [segment.strip() for segment in observation[: footer.start()].split("[SEP]")]
+    if (
+        len(segments) < 7
+        or segments[0] != "Instruction:"
+        or not segments[1]
+        or segments[2] != "Back to Search"
+        or not re.fullmatch(
+            r"Page [1-9][0-9]*(?: of [1-9][0-9]*)? \(Total results: [0-9]+\)",
+            segments[3],
+        )
+    ):
+        return []
+    index = 4
+    if segments[index].startswith("Query: "):
+        if " | Normalized query: " not in segments[index]:
+            return []
+        index += 1
+    visible_navigation = ["back to search"]
+    if index < len(segments) and segments[index] == "< Prev":
+        visible_navigation.append("< prev")
+        index += 1
+    if index < len(segments) and segments[index] == "Next >":
+        visible_navigation.append("next >")
+        index += 1
+    if set(visible_navigation) != {
+        button.casefold() for button in buttons if button.casefold() in navigation
+    }:
+        return []
+    if index == len(segments) or (len(segments) - index) % 3:
+        return []
+    products = []
+    for offset in range(index, len(segments), 3):
+        asin, title, price = segments[offset : offset + 3]
+        if (
+            not re.fullmatch(r"[0-9]{8,12}", asin)
+            or not title
+            or "\n" in title
+            or "\r" in title
+            or not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?(?: to [0-9]+(?:\.[0-9]+)?)?", price)
+        ):
+            return []
+        products.append((asin, title, price))
+    asins = [asin for asin, _, _ in products]
+    if len(asins) != len(set(asins)):
+        return []
+    if set(asins) != {button for button in buttons if button.casefold() not in navigation}:
+        return []
+    return products
+
+
